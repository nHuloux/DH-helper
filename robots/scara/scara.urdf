<?xml version="1.0"?>
<!-- SCARA générique RRPR (4 ddl) — modèle pédagogique original, MIRA / Aflokkat.
     Géométrie en primitives (aucun maillage). Unités : mètres, radians.
     Articulation 3 prismatique d'axe -Z (le coulisseau descend quand q3 > 0), articulation 4 rotoïde d'axe -Z. -->
<robot name="scara">
  <material name="gris"><color rgba="0.55 0.58 0.62 1"/></material>
  <material name="turquoise"><color rgba="0.09 0.60 0.69 1"/></material>
  <material name="anthracite"><color rgba="0.21 0.21 0.21 1"/></material>
  <material name="jaune"><color rgba="1.0 0.81 0.0 1"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <geometry><cylinder radius="0.07" length="0.32"/></geometry>
      <material name="anthracite"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry><box size="0.22 0.22 0.02"/></geometry>
      <material name="gris"/>
    </visual>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.35" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.2689" upper="2.2689" effort="100" velocity="3.0"/>
  </joint>

  <link name="link1">
    <visual>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <geometry><cylinder radius="0.055" length="0.06"/></geometry>
      <material name="turquoise"/>
    </visual>
    <visual>
      <origin xyz="0.125 0 0" rpy="0 0 0"/>
      <geometry><box size="0.25 0.07 0.05"/></geometry>
      <material name="turquoise"/>
    </visual>
    <visual>
      <origin xyz="0.25 0 0.025" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.07"/></geometry>
      <material name="turquoise"/>
    </visual>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.25 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.5307" upper="2.5307" effort="60" velocity="4.0"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="0.10 0 0" rpy="0 0 0"/>
      <geometry><box size="0.20 0.06 0.045"/></geometry>
      <material name="gris"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.06"/></geometry>
      <material name="gris"/>
    </visual>
    <visual>
      <origin xyz="0.20 0 -0.03" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.075"/></geometry>
      <material name="gris"/>
    </visual>
  </link>

  <joint name="joint3" type="prismatic">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.20 0 -0.03" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="0.15" effort="200" velocity="0.5"/>
  </joint>

  <link name="link3">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.012" length="0.34"/></geometry>
      <material name="jaune"/>
    </visual>
  </link>

  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 -0.15" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-6.2832" upper="6.2832" effort="20" velocity="6.0"/>
  </joint>

  <link name="link4">
    <visual>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.04"/></geometry>
      <material name="anthracite"/>
    </visual>
  </link>

  <joint name="tool0_fixed" type="fixed">
    <parent link="link4"/>
    <child link="tool0"/>
    <origin xyz="0 0 -0.04" rpy="0 0 0"/>
  </joint>

  <link name="tool0"/>
</robot>
